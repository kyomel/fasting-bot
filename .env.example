# --- WhatsApp Bot (REQUIRED) ---
# Isi dengan nomor bot & admin masing-masing. ALLOWED_GROUP_JID dipakai
# untuk membatasi command grup ke satu grup WhatsApp yang dipercaya.
BOT_NUMBER=
ADMIN_NUMBER=
ALLOWED_GROUP_JID=
GROUP_NAME=Fasting Group

# DB_CONNECTION (REQUIRED): connection string PostgreSQL
# (contoh: postgresql://user:pass@host:port/db).
# Migrasi schema otomatis via goose saat start.
DB_CONNECTION=

# --- WhatsApp session store (SQLite, tetap dipakai whatsmeow) ---
SESSION_PATH=whatsapp-session.db

# --- HTTP API ---
# Alamat listen REST API (register/login/logout/users/me, GET /healthz).
# Bearer token dikirim plaintext di header Authorization - di production
# WAJIB di-deploy di belakang reverse proxy HTTPS (nginx/caddy), jangan
# expose port ini polos ke internet.
API_ADDR=:8080

# --- Timezone ---
# Gunakan IANA timezone agar parsing jadwal akurat.
APP_TIMEZONE=Asia/Jakarta

# --- QR Code (production VPS only) ---
QR_CODE_PATH=
QR_CODE_HOST=
