# --- WhatsApp Bot (REQUIRED) ---
# Isi dengan nomor bot & admin masing-masing. ALLOWED_GROUP_JID dipakai
# untuk membatasi command grup ke satu grup WhatsApp yang dipercaya.
BOT_NUMBER=
ADMIN_NUMBER=
ALLOWED_GROUP_JID=
GROUP_NAME=Fasting Group

# DB_CONNECTION: connection string PostgreSQL (contoh: postgresql://user:pass@host:port/db).
# Jika terisi, bot pakai PostgreSQL (migrasi schema otomatis via goose saat start).
# Jika kosong, bot memakai SQLite di DATABASE_PATH (mode lama).
DB_CONNECTION=

# --- Timezone ---
# Gunakan IANA timezone agar parsing jadwal akurat.
APP_TIMEZONE=Asia/Jakarta

# --- QR Code (production VPS only) ---
QR_CODE_PATH=
QR_CODE_HOST=
